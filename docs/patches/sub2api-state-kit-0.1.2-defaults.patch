@@ -1196,3 +1196,71 @@ func (s *SettingService) SetOpenAIQuotaAutoPauseSettings(settings OpsOpenAIAccou
 		expiresAt: time.Now().Add(openAIQuotaAutoPauseSettingsCacheTTL).UnixNano(),
 	})
 }
+
+// OpenAICodexTicketDefaults 是「新账号默认开启 STATE」的全局默认；Since 为零值或 Enabled 为 false 时不自动开启任何账号。
+type OpenAICodexTicketDefaults struct {
+	Enabled bool
+	Since   time.Time
+	Plan    string
+	Models  []string
+}
+
+type cachedOpenAICodexTicketDefaults struct {
+	value     OpenAICodexTicketDefaults
+	expiresAt int64
+}
+
+const openAICodexTicketDefaultsCacheTTL = 5 * time.Second
+
+// GetOpenAICodexTicketDefaults 返回后台配置的新账号 STATE 默认项（5 秒缓存）。
+func (s *SettingService) GetOpenAICodexTicketDefaults(ctx context.Context) OpenAICodexTicketDefaults {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if s == nil || s.settingRepo == nil || ctx.Err() != nil {
+		return OpenAICodexTicketDefaults{}
+	}
+	if cached, ok := s.openAICodexTicketDefaultsCache.Load().(*cachedOpenAICodexTicketDefaults); ok && cached != nil {
+		if time.Now().UnixNano() < cached.expiresAt {
+			return cached.value
+		}
+	}
+	dbCtx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	get := func(key string) string {
+		value, err := s.settingRepo.GetValue(dbCtx, key)
+		if err != nil {
+			return ""
+		}
+		return strings.TrimSpace(value)
+	}
+	out := OpenAICodexTicketDefaults{
+		Enabled: get(SettingKeyOpenAICodexTicketDefaultEnabled) == "true",
+		Plan:    normalizeCodexTicketDefaultPlan(get(SettingKeyOpenAICodexTicketDefaultPlan)),
+		Models:  SplitCodexTicketDefaultModels(get(SettingKeyOpenAICodexTicketDefaultModels)),
+	}
+	if raw := get(SettingKeyOpenAICodexTicketDefaultEnabledSince); raw != "" {
+		if parsed, err := time.Parse(time.RFC3339, raw); err == nil {
+			out.Since = parsed
+		}
+	}
+	// 没有生效时间就不自动开启，避免误伤存量账号。
+	if out.Since.IsZero() || out.Plan == "" {
+		out.Enabled = false
+	}
+	if ctx.Err() != nil {
+		return out
+	}
+	s.openAICodexTicketDefaultsCache.Store(&cachedOpenAICodexTicketDefaults{
+		value:     out,
+		expiresAt: time.Now().Add(openAICodexTicketDefaultsCacheTTL).UnixNano(),
+	})
+	return out
+}
+
+func (s *SettingService) InvalidateOpenAICodexTicketDefaultsCache() {
+	if s == nil {
+		return
+	}
+	s.openAICodexTicketDefaultsCache.Store(&cachedOpenAICodexTicketDefaults{expiresAt: 0})
+}
